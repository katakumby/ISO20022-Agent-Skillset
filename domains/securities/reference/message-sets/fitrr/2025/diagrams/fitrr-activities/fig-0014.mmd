flowchart TB
  subgraph laneRE["Reporting Entity"]
  end
  subgraph laneCA["Competent Authority"]
    start(("Start"))
    calculate(["Calculate and Submit Trading Activity Result"])
    fork@{ shape: fork }
    response(["Receive and Process Response"])
    decision{"#160;"}
    correct(["Corrective Action"])
    endCA((("End")))
  end
  subgraph laneSA["Supervisory Authority"]
    receive(["Receive Message"])
    process(["Process Message and Generate Status Advice"])
  end
  start --> calculate
  calculate --> fork
  fork --> receive
  fork --> response
  receive --> process
  process --> response
  response --> decision
  decision -->|"Accepted"| endCA
  decision -->|"Rejected"| correct
  correct --> calculate
  classDef bar fill:#333,stroke:#333,color:#333;
  class fork bar;
