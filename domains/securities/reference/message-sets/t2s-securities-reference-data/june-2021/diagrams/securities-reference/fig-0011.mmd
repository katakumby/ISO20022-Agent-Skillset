%%{init: {"flowchart": {"htmlLabels": false, "wrappingWidth": 260}}}%%
flowchart TB
classDef green fill:#c5d0a5,stroke:#222,color:#000
classDef blue fill:#bfd4ee,stroke:#222,color:#000
classDef grey fill:#eeeeee,stroke:#555,color:#000
classDef bar fill:#222,stroke:#222,color:#222
subgraph A["Instructing Party"]
I("Instruction"):::green
N("Monitor"):::green
end
subgraph B["Executing Party"]
P("Process Statement"):::green
R("Reporting"):::green
end
I --> P --> R --> N
