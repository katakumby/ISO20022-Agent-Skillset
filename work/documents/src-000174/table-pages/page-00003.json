        ],
        [
          "pain.001.001.13\nCustomerCreditTransferInitiationV13",
          "The CustomerCreditTransferInitiation message is sent\nby the initiating party to the forwarding agent or debtor\nagent. It is used to request movement of funds from\nthe debtor account to a creditor."
        ],
        [
          "pain.002.001.15\nCustomerPaymentStatusReportV15",
          "The CustomerPaymentStatusReport message is sent\nby an instructed agent to the previous party in the\npayment chain. It is used to inform this party about the\npositive or negative status of an instruction (either\nsingle or file). It is also used to report on a pending\ninstruction."
        ],
        [
          "pain.007.001.13\nCustomerPaymentReversalV13",
          "The CustomerPaymentReversal message is sent by\nthe initiating party to the next party in the payment\nchain. It is used to reverse a payment previously\nexecuted."
        ],
        [
          "pain.008.001.12\nCustomerDirectDebitInitiationV12",
          "The CustomerDirectDebitInitiation message is sent by\nthe initiating party to the forwarding agent or creditor\nagent. It is used to request single or bulk collection(s)\nof funds from one or various debtor's account(s) for a\ncreditor."
        ]
      ]
    }
