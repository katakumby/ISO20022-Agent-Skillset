        ],
        [
          "",
          "",
          "account when the cheque is cashed.\nSynonym is 'corporate cheque'."
        ],
        [
          "CCCH",
          "CertifiedCustomerCheque",
          "Cheque drawn on the account of the\ndebtor, and debited on the debtor's\naccount when the cheque is cashed. The\nfinancial institution prints and certifies\nthe cheque, guaranteeing the payment."
        ],
        [
          "BCHQ",
          "BankCheque",
          "Cheque drawn on the account of the\ndebtor's financial institution, which is\ndebited on the debtor's account when\nthe cheque is issued.These cheques are\nprinted by the debtor's financial\ninstitution and payment is guaranteed by\nthe financial institution. Synonym is\n'cashier's cheque'."
        ],
        [
          "DRFT",
          "Draft",
          "A guaranteed bank cheque with a future\nvalue date (do not pay before], which in\ncommercial terms is a 'negotiatable\ninstrument': the beneficiary can receive\nearly payment from any bank under\nsubtraction of a discount. The ordering\ncustomer's account is debited on value\ndate."
        ],
        [
          "ELDR",
          "ElectronicDraft",
          "An instrument with a future value date\n(do not pay before], which in commercial\nterms is a 'negotiatable instrument': the\nbeneficiary can receive early payment\nfrom any bank under subtraction of a\ndiscount. The ordering customer's\naccount is debited on value date."
        ]
      ]
