      "rows": [
        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "",
          "",
          "of the bilateral flows exchanged between\nthe two parties. The net bilateral limit can\nbe expressed as a debit or a credit\nbalance."
        ],
        [
          "INBI",
          "IndirectBilateral",
          "Limit is a maximum value set by a direct\nparticipant with respect to its indirect\nparticipant. The limit represents the\nmaximum amount the indirect participant\ncan use to settle its operations."
        ],
        [
          "GLBL",
          "Global",
          "Maximum value set by either the\ntransaction administrator or by a\nmember for the participation of a\nmember in the system. The global limit\nmay be expressed as a credit or debit\nmaximum value and is taken into\naccount by the transaction administrator\nwhen processing transaction inside the\nsystem. With the help of the global limit,\nthe direct participant may limit the use of\nliquidity when clearing specific type of\npayments."
        ],
        [
          "DIDB",
          "DirectDebit",
          "Limit not to be exceeded for direct debit\noperations."
        ],
        [
          "SPLC",
          "SingleCustomerDirectDebit",
          "Single direct debit payment limit not to\nbe exceeded by any single direct debit\ntransaction by a customer."
        ],
        [
          "SPLF",
          "SingleFinancialInstitutionDirectDebit",
          "Single direct debit payment limit not to\nbe exceeded by any single direct debit\ntransaction initiated by a financial\ninstitution."
        ],
        [
          "TDLC",
          "TotalDailyCustomerDirectDebit",
          "Total daily payments limit for customer\ndirect debits not to be exceeded by the\ntotal of all direct debit transactions\ninitiated by customers."
        ],
        [
          "TDLF",
          "TotalDailyFinancialInstitutionDirectDebit",
          "Total daily payments limit for financial\ninstitutions direct debits not to be\nexceeded by the total of all direct debit\ntransactions initiated by financial\ninstitutions."
        ],
        [
          "UCDT",
          "UnsecuredCredit",
          "Limit is related to a cap amount granted\nby a national central bank or a\nsettlement bank, but generally\nunsecured outside of the market\ninfrastructure."
        ],
        [
          "ACOL",
          "AutoCollateralisation",
          "Limit is related to a credit operation that\nis or can be triggered when a buyer does\nnot have a sufficient amount of money to\nsettle a securities transaction in order to\nimprove its cash position for the next\nsettlement cycle. The credit provided can\nbe secured using securities already held\nby the buyer (\"collateral stocks\") or the\nsecurities that are being purchased\n(\"collateral flows\")."
        ]
      ]
    }
