        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "OTHB",
          "OtherBlockedTrades",
          "Balance representing the projected total\nof all cash legs for trades settling via a\ncentral securities depository that have\nbeen matched but blocked in order to not\nsettle. These blocked transactions are\nnot included in the calculation for\nsettlement."
        ],
        [
          "CUST",
          "Custody",
          "Balance representing the projected total\nof all asset servicing transactions such\nas dividends, income corporate actions\nequivalents, tax returns, etc."
        ],
        [
          "FORC",
          "CashForecast",
          "Balance representing the total of all\nbalance types representing transactions\nto settle, blocked items and custody\ntransactions."
        ],
        [
          "COLC",
          "DividendsCollection",
          "Balance representing the projected total\namount of all payment obligations to the\nparticipant (bank), based on their role as\nmain paying agent."
        ],
        [
          "FUND",
          "NetFunding",
          "Balance representing the net amount to\nbe funded resulting from all transactions\nwhich have an impact on the funding\nrequirement."
        ],
        [
          "PIPO",
          "PayInPayOut",
          "Balance representing the fictive forecast\nof automated direct debits or payment\nbased on standing arrangements\nbetween a central securities depository\nand the user.\nUsage: Pay-Ins and Pay-Outs can be\ndifferent based on individual payment\ninstructions or available funds."
        ],
        [
          "XCHG",
          "ExchangeForecast",
          "Balance representing the forecast of the\ntotal of all cash legs of transactions\ntraded in exchanges."
        ],
        [
          "CCPS",
          "CentralCounterparty",
          "Balance representing the forecast of the\ntotal of all cash legs of transactions\ntraded in exchanges that operate a\ncentral counterparty functionality."
        ],
        [
          "TOHB",
          "TotalOnHold",
          "Balance representing the total of the\npayments that were put on hold because\nthe limits have been exceeded."
        ],
        [
          "COHB",
          "CreditOnHold",
          "Balance representing the total incoming\npayments that were put on hold because\nthe credit limit has been exceeded."
        ],
        [
          "DOHB",
          "DebitOnHold",
          "Balance representing the total outgoing\npayments that were put on hold because\nthe debit limit has been exceeded."
        ],
        [
          "TPBL",
          "TotalProcessed",
          "Balance representing the total of the\npayments that have been processed and\nare waiting for settlement during the day."
        ]
      ]
