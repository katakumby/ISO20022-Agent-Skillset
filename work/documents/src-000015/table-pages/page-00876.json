        [
          "",
          "",
          "day debit balance if everything books to\nthe account and no other debit entry is\nposted."
        ],
        [
          "ADJT",
          "Adjustment",
          "Average balance to be held in the\nsettlement account at the end of each\nday in order to fulfil the reserve due.\nThe approximation will be always made\nrounding up."
        ],
        [
          "PRAV",
          "ProgressiveAverage",
          "Average of the daily balances on the\naccount used to fulfil the reserve\nrequirements calculated from the\nbeginning of the maintenance period."
        ],
        [
          "DBIT",
          "Debit",
          "Balance representing the sum of all debit\nentries booked to an account."
        ],
        [
          "THRE",
          "Threshold",
          "Balance representing the amount that\nwill be destined for investment.\nDifference between available balance\nand threshold for investment limit."
        ],
        [
          "NOTE",
          "Noted",
          "Balance representing the amount that a\nfinancial institution has set aside for a\nspecific reason and which is therefore\nnot available."
        ],
        [
          "FSET",
          "ForecastSettlement",
          "Balance representing the forecast of\ntotal of all cash legs for trades that are\nready to settle via a central securities\ndepository. Amounts shown are still\nsubject to processing of the securities\nsettlement."
        ],
        [
          "BLOC",
          "BlockedTrades",
          "Balance representing the projected total\nof all cash legs for trades settling via a\ncentral securities depository that have\nbeen matched but blocked in order to not\nsettle. These blocked trades are\nincluded in the calculation for settlement\n(for example to avoid overdrafts).\nUsage rule: Blocking can be done by\naccount owner or its counterparties.\nUsually this is done to chain transactions\nor to prioritise other trades. Blocked\ntrades have an indicator that prevents\nthe transactions from settling. Once\nmatched, they can settle whenever the\nfreeze is lifted. In this case they will\nmove to FSET. Lifting the freeze can\nhappen anytime during the day and the\ntransaction will be settling in the next\nsettlement cycle which can be the same\nday if the (international) central\nsecurities depository's operates several\nsettlements cycles per day."
        ],
        [
          "OTHB",
          "OtherBlockedTrades",
