        [
          "SLST",
          "StandingOrderList",
          "Used to query the list of liquidity transfer\nstanding orders defined in the system."
        ],
        [
          "SDTL",
          "StandingOrderDetails",
          "Used to query a specific liquidity transfer\nstanding order based on a set of search\ncriteria."
        ],
        [
          "TAPS",
          "TotalAmountPerStandingOrder",
          "Used to query the total amounts of\npredefined and user defined liquidity\ntransfer standing orders for both defined\nand not yet executed orders."
        ],
        [
          "SLSL",
          "StandingOrderLinkSetList",
          "Used to query the list of liquidity transfer\nstanding orders defined in a specific link\nset of sequenced standing orders. The\nlink set is a collection of standing order\ndefined in a specific sequence."
        ],
        [
          "SWLS",
          "StandingOrderDetailsWithinLinkSet",
