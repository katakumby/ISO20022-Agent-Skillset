        [
          "BOOK",
          "Book",
          "Balance that is registered in the books of\nthe account servicer."
        ],
        [
          "CRRT",
          "Current",
          "Balance of the account at a precise\nmoment in time."
        ],
        [
          "PDNG",
          "Pending",
          "Balance of securities pending delivery,\nsuch as the orders to sell securities have\nbeen executed but settlement of the\nopen transactions has not been\nconfirmed."
        ],
        [
          "LRLD",
          "LimitRelated",
          "Balance of a specific limit value, such as\na bilateral balance is calculated in\nrelation to a given bilateral limit."
        ],
        [
          "AVLB",
          "Available",
          "Balance of money or securities that is at\nthe disposal of the account owner on the\ndate specified."
        ],
        [
          "LTSF",
          "LiquidityTransfer",
          "Balance composed of the sum of all\nliquidity transfers made to or from an\naccount."
        ],
        [
          "CRDT",
          "Credit",
          "Balance representing the sum of all\ncredit entries booked to an account."
        ],
        [
          "EAST",
          "EligibleAssets",
          "Balance representing the potential loan a\nCentral Bank would make in cash if the\ncollateral is pledged, such as securities\navailable and eligible as collateral with\nthe central bank."
        ],
        [
          "PYMT",
          "Payment",
          "Balance representing the sum of entries\nas a result of payments processing.\nEntries relating to fees, interest, or other\nmovements not a result of payments\nsent or received by the account owner\nare not included."
        ],
        [
          "BLCK",
          "Blocked",
          "Balance representing the regulatory\nreserve that a financial institution must\nhave with the account servicing\ninstitution, such as the minimum credit\nbalance a financial institution is to keep\nwith its Central Bank for mandatory\nreserve purposes. In some countries, a\nblocked balance is known as a 'reserve'\nbalance."
        ],
        [
          "XPCD",
          "Expected",
          "Balance, composed of booked entries\nand pending items known at the time of\ncalculation, which projects the end of\nday balance if everything is booked on\nthe account and no other entry is posted."
        ],
        [
          "DLOD",
          "DaylightOverdraft",
          "Balance representing the intra day\noverdraft granted by the central bank to\nfinancial institutions participating in a\nRTGS system. This balance may vary\nover time and shall be offset at the end\nof the day."
        ],
        [
