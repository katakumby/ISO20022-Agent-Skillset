      "rows": [
        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "BOOK",
          "Booked",
          "Booked means that the transfer of\nmoney has been completed between\naccount servicer and account owner\nUsage:\nStatus Booked does not necessarily\nimply finality of money as this depends\non other factors such as the payment\nsystem used, the completion of the end-\nto-end transaction and the terms agreed\nbetween account servicer and owner.\nStatus Booked is the only status that can\nbe reversed."
        ],
        [
          "PDNG",
          "Pending",
          "Booking on the account owner's account\nin the account servicer's ledger has not\nbeen completed.\nUsage: this can be used for expected\nitems, or for items for which some\nconditions still need to be fulfilled before\nthey can be booked. If booking takes\nplace, the entry will be included with\nstatus Booked in subsequent account\nreport or statement. Status Pending\ncannot be reversed."
        ],
        [
          "FUTR",
          "Future",
          "Entry is on the books of the account\nservicer and value will be applied to the\naccount owner at a future date and time."
        ]
      ]
    },
