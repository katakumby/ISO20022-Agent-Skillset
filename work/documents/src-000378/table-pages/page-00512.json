          "LGAL",
          "LongestAverageLife",
          "The yield assuming only mandatory\nsinks are taken. This results in a lower\npaydown of debt; the yield is then\ncalculated to the final payment date."
        ],
        [
          "MARK",
          "MarkToMarket",
          "An adjustment in the valuation of a\nsecurities portfolio to reflect the current\nmarket values of the respective\nsecurities in the portfolio."
        ],
        [
          "YTMA",
          "YieldToMaturity",
          "Internal rate of return an investor would\nachieve if he or she purchased that bond\nat its current dirty price, and held it to\nmaturity, assuming all coupon and\nprincipal payments are received as\nscheduled."
        ],
        [
          "NXRF",
          "ToNextRefund",
          "Yield To Next Refund (Sinking Fund\nBonds) - Yield assuming all bonds are\nredeemed at the next refund date at the\nredemption price."
        ],
        [
          "PNAV",
          "OpenAverage",
          "The average yield of the respective\nsecurities in the portfolio."
        ],
        [
          "NXPT",
          "ToNextPut",
          "The yield to the date at which the bond\nholder can next put the bond to the\nissuer."
        ],
        [
          "PRCL",
          "PreviousClose",
          "The yield of a bond based on the closing\nprice 1 day ago."
        ],
        [
          "PRYL",
          "Proceeds",
          "The CD equivalent yield when the\nremaining time to maturity is less than\ntwo years."
        ],
        [
          "SEMI",
          "SemiAnnual",
          "The yield of a bond whose coupon\npayments are reinvested semi-annually."
        ],
        [
          "SHLF",
          "ShortestAverageLife",
          "The yield assuming that all sinks\n(mandatory and voluntary) are taken at\npar. This results in a faster paydown of\ndebt; the yield is then calculated to the\nshortest average life date."
        ],
        [
          "SPLL",
          "Simple",
          "The yield of a bond assuming no\nreinvestment of coupon payments.\n(Act/360 day count)."
        ],
