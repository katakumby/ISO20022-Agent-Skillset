        [
          "MessageDefinition",
          "Definition"
        ],
        [
          "",
          "The SecurityDeletionStatusAdvice message is sent as\na response to the request of the instructing party.\nThe instructing party - executing/servicing party\nrelationship may be:\n- Central Securities Depositories (CSD) who would like\nto publish security static data, or\n- a Corporate, or\n- a Bank, or\n- a Market Infrastructure, or\n- a Market Data Provider."
        ],
        [
          "reda.033.001.01\nSecuritiesAuditTrailQueryV01",
          "The SecuritiesAuditTrailQuery message is sent by an\ninstructing party to the executing party to query for the\nsecurities audit trail recorded in the system."
        ],
        [
          "reda.034.001.01\nSecuritiesAuditTrailReportV01",
          "The SecuritiesAuditTrailReport message is sent by the\nexecuting party to an instructing party to provide\ndetailed information on the requested securities audit\ntrail recorded in the system."
        ]
      ]
