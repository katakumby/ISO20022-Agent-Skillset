        [
          "AFTX",
          "AfterTax",
          "The yield on the bond net of any tax\nconsequences from holding the bond.\nThe discount on municipal securities can\nbe subject to both capital gains taxes\nand ordinary income taxes. Calculated\nfrom dollar price."
        ],
        [
          "ANNU",
          "Annual",
          "The annual interest or dividend income\nan investment earns, expressed as a\npercentage of the investment's total\nvalue."
        ],
        [
          "ISSU",
          "AtIssue",
          "The yield of the bond offered on the\nissue date."
        ],
        [
          "AVMA",
          "ToAverageMaturity",
          "The yield achieved by substituting a\nbond's average maturity for the issue's\nfinal maturity date."
        ],
        [
          "BOOK",
          "Book",
          "The yield of a security calculated by\nusing its book value instead of the\ncurrent market price. This term is\ntypically used in the US domestic\nmarket."
        ],
        [
          "YTNC",
          "YieldToNextCall",
          "Yield of a bond to the next possible call\ndate."
        ],
        [
          "CHCL",
          "ChangeSinceClose",
          "The change in the yield since the\nprevious day's closing yield."
        ],
        [
          "CLOS",
          "Closing",
          "The yield of a bond based on the closing\nprice."
        ],
        [
          "CMPD",
          "Compound",
          "The yield of certain Japanese bonds\nbased on its price. Certain Japanese\nbonds have irregular first or last\ncoupons, and the yield is calculated\ncompound for these irregular periods."
        ],
        [
          "CUYI",
          "CurrentYield",
          "The ratio of the interest payment amount\nto the clean price."
        ],
        [
          "TRGR",
          "TrueGross",
          "Yield calculated using the price including\naccrued interest, where coupon dates\nare moved from holidays and weekends\nto the next trading day."
        ],
        [
          "GVEQ",
          "GovernmentEquivalent",
          "Ask yield based on semi-annual coupons\ncompounding in all periods and actual/\nactual calendar."
        ],
        [
          "FLAS",
          "InflationAssumption",
