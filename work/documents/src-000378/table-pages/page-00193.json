        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "NET1",
          "NetOfAll",
          "Price is a net price, ie, net of all charges,\nfees and taxes."
        ],
        [
          "NUND",
          "NetUndisclosed",
          "Price is net to the client undisclosed\n(used in the UK market)."
        ],
        [
          "NOGR",
          "NotionalGross",
          "Price is notional gross (used in the UK\nmarket)."
        ],
        [
          "PARV",
          "ParValue",
          "Price is equal to the nominal or face\nvalue of the instrument."
        ],
        [
          "RDAV",
          "RoundedAverage",
          "Price is a rounded average price."
        ],
        [
          "STOP",
          "Stop",
          "Price is a stop price used in an order to\nbuy. The order becomes a market order\nwhen the financial instrument trades at\nor above the stop price after the order is\nsubmitted. In an order to sell the order\nbecomes a market order when the\nfinancial instrument trades at or below\nthe stop price."
        ]
      ]
