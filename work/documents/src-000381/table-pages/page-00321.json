          "",
          "",
          "options, as the result of two or more\ncompanies combining assets, that is, an\nexternal, third party company. Cash\npayments may accompany share\nexchange."
        ],
        [
          "NOOF",
          "NonOfficialOffer",
          "Offers that are not supervised or\nregulated by an official entity and being\noffered by a party, for example a broker,\nusually at a discount price, for example\nbroker offer, mini-tender, mini odd lot\noffer or third party offer."
        ],
        [
          "CERT",
          "NonUSTEFRADCertification",
          "Non-US beneficial owner certification\nrequirement for exchange of temporary\nto permanent notes."
        ],
        [
          "ODLT",
          "OddLotSalePurchase",
          "Sale or purchase of odd-lots to/from the\nissuing company, initiated either by the\nholder of the security or through an offer\nmade by the issuer."
        ],
        [
          "OTHR",
          "OtherEvent",
          "Other event, use only when no other\nevent type applies, for example, a new\nevent type."
        ],
        [
          "PARI",
          "PariPassu",
          "Occurs when securities with different\ncharacteristics, for example, shares with\ndifferent entitlements to dividend or\nvoting rights, become identical in all\nrespects, for example, pari-passu or\nassimilation. May be scheduled in\nadvance, for example, shares resulting\nfrom a bonus may become fungible after\na pre-set period of time, or may result\nfrom outside events, for example,\nmerger, reorganisation, issue of\nsupplementary tranches."
        ],
        [
          "PCAL",
          "PartialRedemptionWithoutPoolFactorReduction",
          "Securities are redeemed in part before\ntheir scheduled final maturity date. It is\ndone without any pool factor reduction.\nThe redemption is reflected in a debit of\nthe face amount (FAMT)."
        ],
        [
          "PRED",
          "PartialRedemptionWithPoolFactorReduction",
          "Securities are redeemed in part before\ntheir scheduled final maturity date. The\nredemption is reflected in a pool factor\nreduction. No movement of securities\noccurs."
        ],
        [
          "PINK",
          "PayInKind",
          "Interest payment, in any kind except\ncash, distributed to holders of an interest\nbearing asset."
        ],
        [
          "PLAC",
          "PlaceOfIncorporation",
          "Changes in the state of incorporation for\nUS companies and changes in the place\nof incorporation for foreign companies.\nWhere shares need to be registered\nfollowing the incorporation change, the\nholder(s) may have to elect the registrar."
        ],
