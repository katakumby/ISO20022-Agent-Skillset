        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "BONU",
          "BonusIssue",
          "Bonus or capitalisation issue. Security\nholders receive additional assets free of\npayment from the issuer, in proportion to\ntheir holding."
        ],
        [
          "EXRI",
          "CallOnIntermediateSecurities",
          "Call or exercise on nil paid securities or\nintermediate securities resulting from an\nintermediate securities distribution\n(RHDI). This code is used for the second\nevent, when an intermediate securities'\nissue (rights/coupons) is composed of\ntwo events, the first event being the\ndistribution of intermediate securities."
        ],
        [
          "CAPD",
          "CapitalDistribution",
          "Corporate event pays shareholders an\namount in cash issued from the capital\naccount. There is no reduction to the\nface value of a single share (or the share\nhas no par value). The number of\ncirculating shares remains unchanged."
        ],
        [
          "CAPG",
          "CapitalGainsDistribution",
          "Event is the distribution of profits\nresulting from the sale of securities.\nShareholders of mutual funds, unit\ntrusts, or SICAVs are recipients of\ncapital gains distributions and are often\nreinvested in additional shares of the\nfund."
        ],
        [
          "CAPI",
          "Capitalisation",
          "Increase of the current principal of a debt\ninstrument without increasing the\nnominal value. It normally arises from\nthe incorporation of due but unpaid\ninterest into the principal. This is\ncommonly done by increasing the pool\nfactor value, for example, capitalisation,\nand negative amortisation."
        ],
        [
          "DRCA",
          "CashDistributionFromNonEligibleSecuritiesSale\ns",
          "Distribution to shareholders of cash\nresulting from the selling of non-eligible\nsecurities, for example, in the frame of a\ndepositary receipt program."
        ],
        [
          "DVCA",
          "CashDividend",
          "Distribution of cash to shareholders, in\nproportion to their equity holding.\nOrdinary dividends are recurring and\nregular. Shareholder must take cash and\nmay be offered a choice of currency."
        ],
        [
          "CHAN",
          "Change",
          "Information regarding a change further\ndescribed in the corporate action details."
        ],
        [
          "COOP",
          "CompanyOption",
          "Company option may be granted by the\ncompany, allowing the holder to take up\nshares at some future date(s) at a pre\narranged price in the company. A\ncompany may not grant options which\nenable the holder to take up unissued\nshares at a time which is five or more\nyears from the date of the grant. Option\nholders are not members of a company.\nThey are contingent creditors of a\ncompany and hence may, in some\ninstances, be entitled to vote on and be\nbound by a scheme of arrangement\nbetween the creditors and the company."
        ]
      ]
