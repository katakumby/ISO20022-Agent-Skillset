      "rows": [
        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "",
          "",
          "shares in the issuing company. To be\ndistinguished from DVOP as the\ncompany invests the dividend in the\nmarket rather than creating new share\ncapital in exchange for the dividend."
        ],
        [
          "DRAW",
          "Drawing",
          "Securities are redeemed in part before\nthe scheduled final maturity date. It is\ndone without any pool factor reduction.\nThe redemption is reflected in a debit of\nthe face amount (FAMT). Drawing is\ndistinct from partial call since drawn\nbonds are chosen by lottery. Therefore,\nnot every holder is affected in the same\nway."
        ],
        [
          "DTCH",
          "DutchAuction",
          "Action by a party wishing to acquire a\nsecurity. Holders of the security are\ninvited to make an offer to sell, within a\nspecific price range. The acquiring party\nwill buy from the holder with lowest offer."
        ],
        [
          "EXOF",
          "Exchange",
          "Exchange of holdings for other securities\nand/or cash. The exchange can be either\nmandatory or voluntary involving the\nexchange of outstanding securities for\ndifferent securities and/or cash. For\nexample \"exchange offer\", \"capital\nreorganisation\" or \"funds separation\"."
        ],
        [
          "REDM",
          "FinalMaturity",
          "Redemption of an entire issue\noutstanding of securities, for example,\nbonds, preferred equity, funds, by the\nissuer or its agent, for example, asset\nmanager, at final maturity."
        ],
        [
          "MCAL",
          "FullCall",
          "Redemption of an entire issue\noutstanding of securities, for example,\nbonds, preferred equity, funds, by the\nissuer or its agent, for example, asset\nmanager, before final maturity."
        ],
        [
          "INCR",
          "IncreaseInValue",
          "Increase in the face value of a single\nsecurity. The number of circulating\nsecurities remains unchanged."
        ],
        [
          "PPMT",
          "InstalmentCall",
          "Instalment towards the purchase of\nequity capital, subject to an agreement\nbetween an issuer and a purchaser."
        ],
        [
          "INTR",
          "InterestPayment",
          "Interest payment distributed to holders of\nan interest bearing asset."
        ],
        [
          "PRII",
          "InterestPaymentWithPrincipal",
          "Event which consists of two\ncomponents, the decrease of the\namortized value of a pool factor security\nand an interest payment."
        ],
        [
          "RHDI",
          "IntermediateSecuritiesDistribution",
          "Distribution of intermediate securities\nthat gives the holder the right to take part\nin a future event."
        ],
        [
          "LIQU",
          "LiquidationDividend",
          "Distribution of cash, assets or both. Debt\nmay be paid in order of priority based on\npreferred claims to assets specified by\nthe security."
        ]
      ]
    }
