      "rows": [
        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "",
          "",
          "was starting on 30 Feb when the end of\nthe period is the 30th or the 31st, or two\ndays of interest in February when the\nend of the period is the 29th, or three\ndays of interest in February when it is 28\nFeb of a non-leap year and the end of\nthe period is before the 29th."
        ],
        [
          "A013",
          "IC30E3360orEurobondbasismodel3",
          "Method whereby interest is calculated\nbased on a 30-day month and a 360-day\nyear. Accrued interest to a value date on\nthe last day of a month shall be the\nsame as to the 30th calendar day of the\nsame month. This means that the 31st is\nassumed to be the 30th and 28 Feb (or\n29 Feb for a leap year) is assumed to be\nequivalent to 30 Feb. It is a variation of\nthe 30E/360 (or Eurobond basis) method\nwhere the last day of February is always\nassumed to be the 30th, even if it is the\nlast day of the maturity coupon period."
        ],
        [
          "A014",
          "Actual365NL",
          "Method whereby interest is calculated\nbased on the actual number of accrued\ndays in the interest period, excluding any\nleap day from the count, and a 365-day\nyear."
        ],
        [
          "NARR",
          "Narrative",
          "Other method than A001-A020. See\nNarrative."
        ]
      ]
    },
