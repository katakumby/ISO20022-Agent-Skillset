        [
          "",
          "",
          "company may not grant options which\nenable the holder to take up unissued\nshares at a time which is five or more\nyears from the date of the grant. Option\nholders are not members of a company.\nThey are contingent creditors of a\ncompany and hence may, in some\ninstances, be entitled to vote on and be\nbound by a scheme of arrangement\nbetween the creditors and the company.\nAs many options have multiple exercise\nperiods a company option will either\nlapse or carry on to the next expiry date."
        ],
        [
          "CLSA",
          "ClassActionProposedSettlement",
          "Situation where interested parties seek\nrestitution for financial loss. The security\nholder may be offered the opportunity to\njoin a class action proceeding and would\nneed to respond with an instruction."
        ],
        [
          "CONS",
          "Consent",
          "Procedure that aims to obtain consent of\nholder to a proposal by the issuer or a\nthird party without convening a meeting.\nFor example, consent to change the\nterms of a bond."
        ],
        [
          "CONV",
          "Conversion",
          "Conversion of securities (generally\nconvertible bonds or preferred shares)\ninto another form of securities (usually\ncommon shares) at a pre-stated price/\nratio."
        ],
        [
          "CREV",
          "CreditEvent",
          "Occurrence of credit derivative for which\nthe issuer of one or several underlying\nsecurities is unable to fulfill its financial\nobligations (as defined in terms and\nconditions)."
        ],
        [
          "DECR",
          "DecreaseInValue",
          "Reduction of face value of a single share\nor the value of fund assets. The number\nof circulating shares/units remains\nunchanged. This event may include a\ncash payout to holders."
        ],
        [
          "DETI",
          "Detachment",
          "Separation of components that comprise\na security, for example, usually units\ncomprised of warrants and bond or\nwarrants and equity. Units may be\nbroken up at the request of the security\nholder or based on market convention."
        ],
        [
          "DSCL",
          "Disclosure",
          "Requirement for holders or beneficial\nowners to disclose their name, location\nand holdings of any issue to the issuer."
        ],
        [
          "DVOP",
          "DividendOption",
          "Distribution of a dividend to shareholders\nwith a choice of benefit to receive.\nShareholders may choose to receive\nshares or cash. To be distinguished from\nDRIP as the company creates new share\ncapital in exchange for the dividend\nrather than investing the dividend in the\nmarket."
        ],
        [
          "DRIP",
          "DividendReinvestment",
          "Dividend payment where holders can\nkeep cash or have the cash reinvested in\nthe market by the issuer into additional"
        ]
      ]
