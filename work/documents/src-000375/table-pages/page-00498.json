          "PRII",
          "InterestPaymentWithPrincipal",
          "Event which consists of two\ncomponents, the decrease of the\namortized value of a pool factor security\nand an interest payment."
        ],
        [
          "RHDI",
          "IntermediateSecuritiesDistribution",
          "Distribution of intermediate securities\nthat gives the holder the right to take part\nin a future event."
        ],
        [
          "LIQU",
          "LiquidationDividend",
          "Distribution of cash, assets or both. Debt\nmay be paid in order of priority based on\npreferred claims to assets specified by\nthe security."
        ],
        [
          "EXTM",
          "MaturityExtension",
          "As stipulated in the security's Terms and\nConditions, the issuer or the holder may\nprolong the maturity date of a security.\nAfter extension, the security details may\ndiffer from the original issue. An issuer\ninitiated extension may be subject to\nholder's approval."
        ],
        [
          "MRGR",
          "Merger",
          "Exchange of outstanding securities,\ninitiated by the issuer which may include\noptions, as the result of two or more\ncompanies combining assets, that is, an\nexternal, third party company. Cash\npayments may accompany share\nexchange."
        ],
        [
          "NOOF",
          "NonOfficialOffer",
          "Offers that are not supervised or\nregulated by an official entity and being\noffered by a party, for example a broker,\nusually at a discount price, for example\nbroker offer, mini-tender, mini odd lot\noffer or third party offer."
        ],
