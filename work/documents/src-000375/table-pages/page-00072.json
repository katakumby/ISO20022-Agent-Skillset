        ],
        [
          "DNIN",
          "NotIncrease",
          "A limit order to buy or a stop order to sell\nor a stop limit order which is not to be\nincreased in shares on the ex-dividend\ndate as a result of a stock dividend or\ndistribution."
        ],
        [
          "DNRE",
          "NotReduce",
          "A limit order to buy or a stop order to\nsell, or a stop-limit order to sell which is\nnot to be reduced in price by the amount\nof an ordinary cash dividend. Only\napplies to ordinary stock dividends; it\nshould be reduced for other distributions.\ne.g. when a stock goes 'ex' stock\ndividend or rights."
        ],
