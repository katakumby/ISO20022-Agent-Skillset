          "SCEX",
          "SecuritiesNoLongerEligible",
          "Transaction has been cancelled; the\nsecurity no longer exists or is no longer\neligible on the market instructed. For\ncorporate action related cancellation,\nCORP should be used."
        ],
        [
          "OTHR",
          "Other",
          "Other. See Narrative."
        ],
        [
          "CXLR",
          "EndOfLife",
          "Transaction is rejected by the executing\nparty, the rejection is final therefore the\norder is cancelled in the system."
        ],
        [
          "BYIY",
          "CancelledDueToBuyIn",
          "Instruction has been cancelled because\na buy-in has been initiated."
        ],
        [
          "CTHP",
          "CancelledByThirdParty",
          "Instruction is cancelled by a Third party."
        ],
        [
          "CANZ",
          "CancelledSplitPartialSettlement",
