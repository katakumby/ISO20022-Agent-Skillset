        ],
        [
          "",
          "",
          "commonly done by increasing the pool\nfactor value, for example, capitalisation,\nand negative amortisation."
        ],
        [
          "DRCA",
          "CashDistributionFromNonEligibleSecuritiesSale\ns",
          "Distribution to shareholders of cash\nresulting from the selling of non-eligible\nsecurities, for example, in the frame of a\ndepositary receipt program."
        ],
        [
          "DVCA",
          "CashDividend",
          "Distribution of cash to shareholders, in\nproportion to their equity holding.\nOrdinary dividends are recurring and\nregular. Shareholder must take cash and\nmay be offered a choice of currency."
        ],
        [
          "CHAN",
          "Change",
          "Information regarding a change further\ndescribed in the corporate action details."
        ],
        [
          "COOP",
          "CompanyOption",
          "Company option may be granted by the\ncompany, allowing the holder to take up\nshares at some future date(s) at a pre\narranged price in the company. A\ncompany may not grant options which\nenable the holder to take up unissued\nshares at a time which is five or more\nyears from the date of the grant. Option\nholders are not members of a company.\nThey are contingent creditors of a\ncompany and hence may, in some\ninstances, be entitled to vote on and be\nbound by a scheme of arrangement\nbetween the creditors and the company.\nAs many options have multiple exercise\nperiods a company option will either\nlapse or carry on to the next expiry date."
        ],
        [
          "CLSA",
          "ClassActionProposedSettlement",
          "Situation where interested parties seek\nrestitution for financial loss. The security\nholder may be offered the opportunity to\njoin a class action proceeding and would\nneed to respond with an instruction."
        ],
        [
          "CONS",
          "Consent",
          "Procedure that aims to obtain consent of\nholder to a proposal by the issuer or a\nthird party without convening a meeting.\nFor example, consent to change the\nterms of a bond."
        ],
        [
          "CONV",
          "Conversion",
          "Conversion of securities (generally\nconvertible bonds or preferred shares)\ninto another form of securities (usually\ncommon shares) at a pre-stated price/\nratio."
        ],
        [
          "CREV",
          "CreditEvent",
          "Occurrence of credit derivative for which\nthe issuer of one or several underlying\nsecurities is unable to fulfill its financial\nobligations (as defined in terms and\nconditions)."
        ],
        [
          "DECR",
          "DecreaseInValue",
          "Reduction of face value of a single share\nor the value of fund assets. The number\nof circulating shares/units remains\nunchanged. This event may include a\ncash payout to holders."
        ]
      ]
