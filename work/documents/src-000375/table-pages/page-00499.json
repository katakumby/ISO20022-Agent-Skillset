        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "",
          "",
          "The redemption is reflected in a debit of\nthe face amount (FAMT)."
        ],
        [
          "PRED",
          "PartialRedemptionWithPoolFactorReduction",
          "Securities are redeemed in part before\ntheir scheduled final maturity date. The\nredemption is reflected in a pool factor\nreduction. No movement of securities\noccurs."
        ],
        [
          "PINK",
          "PayInKind",
          "Interest payment, in any kind except\ncash, distributed to holders of an interest\nbearing asset."
        ],
        [
          "PLAC",
          "PlaceOfIncorporation",
          "Changes in the state of incorporation for\nUS companies and changes in the place\nof incorporation for foreign companies.\nWhere shares need to be registered\nfollowing the incorporation change, the\nholder(s) may have to elect the registrar."
        ],
        [
          "PDEF",
          "Prefunding",
          "Also called partial defeasance. Issuer\nhas money set aside to redeem a portion\nof an issue and the indenture states that\nthe securities could be called earlier than\nthe stated maturity."
        ],
        [
          "PRIO",
          "PriorityIssue",
          "Form of open or public offer where, due\nto a limited amount of securities\navailable, priority is given to existing\nshareholders."
        ],
        [
          "BPUT",
          "PutRedemption",
          "Early redemption of a security at the\nelection of the holder subject to the\nterms and condition of the issue with no\nreduction in nominal value."
        ],
        [
          "REDO",
          "Redenomination",
          "Event by which the unit (currency and/or\nnominal) of a security is restated, for\nexample, nominal/par value of security in\na national currency is restated in another\ncurrency."
        ],
        [
          "REMK",
          "RemarketingAgreement",
          "Purchase and sale of remarketed\npreferred equities/bonds through the\nnegotiation of interest rate between the\nissuers and the holders."
        ],
        [
          "BIDS",
          "RepurchaseOffer",
          "Repurchase offer / issuer bid / reverse\nrights. Offer to existing holders by the\nissuing company to repurchase its own\nsecurities. The objective of the offer is to\nreduce the number of outstanding\nsecurities."
        ],
        [
          "SPLR",
          "ReverseStockSplit",
          "Decrease in a company's number of\noutstanding equities without any change\nin the shareholder's equity or the\naggregate market value at the time of\nthe split. Equity price and nominal value\nare increased accordingly."
        ],
        [
          "RHTS",
          "RightsIssue",
          "Offer to holders of a security to\nsubscribe for additional securities via the\ndistribution of an intermediate security.\nBoth processes are included in the same\nevent."
        ]
      ]
