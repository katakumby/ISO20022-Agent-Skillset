      "rows": [
        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "BIDE",
          "Bid",
          "Price is the calculated bid price of a\ndual-priced fund (offer-bid prices), that\nis, the selling price of the units for the\ninvestor."
        ],
        [
          "OFFR",
          "Offer",
          "Price is the calculated offer price of a\ndual-priced investment fund (offer-bid\nprices), that is, the buying price of the\nunits for an investor."
        ],
        [
          "NAVL",
          "NetAssetValue",
          "Price is the net asset value per unit that\nis used either as a transacting price for a\nsingle-priced investment fund class, or\nas a notional price for the calculation of\nother prices."
        ],
        [
          "CREA",
          "Creation",
          "Price is the calculated creation price of a\ndual-priced investment fund (creation-\ncancellation prices) and the highest\npossible buying price of the units before\nthe initial charge. The actual buying or\noffer price, which includes charges, will\nbe higher."
        ],
        [
          "CANC",
          "Cancellation",
          "Price is the calculated cancellation price\nof a dual-priced investment fund\n(creation-cancellation price), and the\nlowest possible valuation of the units on\nany one-day. The actual selling or bid\nprice is usually higher."
        ],
        [
          "INTE",
          "Interim",
          "Price is the non-official interim price\ngiven to an investor before the executed\nprice."
        ],
        [
          "SWNG",
          "Swing",
          "Price is the calculated net asset value\nprice of a single-priced investment fund.\nThe price is adjusted to take into account\nthe dealing costs due to individual large\ndeals, or due to a significant imbalance\nin volumes of subscriptions vs\nredemptions, as an alternative to dilution\nlevy."
        ],
        [
          "MIDD",
          "Mid",
          "Price is the average price between the\nbid and offer prices."
        ],
        [
          "RINV",
          "Reinvestment",
          "Price is the price used when reinvesting\nunits after distribution."
        ],
        [
          "SWIC",
          "Switch",
          "Price is the price used when transferring\nunits between products."
        ],
        [
          "MRKT",
          "Market",
          "Price is the current market price."
        ],
        [
          "INDC",
          "Indicative",
          "Price is the estimated indicative price."
        ]
      ]
    }
