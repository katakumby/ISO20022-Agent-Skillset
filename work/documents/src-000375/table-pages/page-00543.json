        [
          "CodeName",
          "Name",
          "Definition"
        ],
        [
          "CLEN",
          "Clean",
          "Indicates that the trade is executed\nclean, ie government tax must not be\npaid on the accrued interest on the bond."
        ],
        [
          "BLKO",
          "Block",
          "Indicates whether the trade is a block\ntrade or not, ie, whether allocation\ninstruction will follow or not."
        ],
        [
          "GTDL",
          "GuaranteedDelivery",
          "Indicates whether the delivery of the\nfinancial instrument on settlement date\nis guaranteed."
        ],
        [
          "FRAC",
          "Fractions",
          "Indicates whether fractional parts are\nallowed."
        ],
        [
          "CRST",
          "CrossTrade",
          "Indicates that cross trades are allowed\nwhereby buy and sell orders are offset\nwithout recording the trade on the\nexchange."
        ],
        [
          "NCRS",
          "NoCrossTrade",
          "Indicates that cross trades, whereby buy\nand sell orders are offset without\nrecording the trade on the exchange, are\nnot allowed."
        ],
        [
          "DORD",
          "DirectOrder",
          "Indicates that the order is to be executed\nby a trading party other than the trading\nparty to which the\norder is sent. In this case, the instructing\nparty has traded with another broker\nwhich will\nsubsequently send an advice of\nexecution to the executing party who\nreceived the order\nand which is acting as clearing broker."
        ],
        [
          "DIOR",
          "DirectedOrder",
          "Indicates that the order must be\nexecuted with a specific trading party."
        ],
        [
          "WARE",
          "WarehouseTrade",
          "Warehouse Trade."
        ],
        [
          "DNIN",
          "NotIncrease",
          "A limit order to buy or a stop order to sell\nor a stop limit order which is not to be\nincreased in shares on the ex-dividend\ndate as a result of a stock dividend or\ndistribution."
        ],
        [
          "DNRE",
          "NotReduce",
          "A limit order to buy or a stop order to\nsell, or a stop-limit order to sell which is\nnot to be reduced in price by the amount\nof an ordinary cash dividend. Only\napplies to ordinary stock dividends; it\nshould be reduced for other distributions.\ne.g. when a stock goes 'ex' stock\ndividend or rights."
        ],
        [
          "FORW",
          "ForwardPriceTrade",
          "Indicates that the order is based on a\nforward price."
        ],
        [
          "HIST",
          "HistoricPriceTrade",
          "Indicates that the order is based on a\nhistoric price."
        ]
      ]
    }
