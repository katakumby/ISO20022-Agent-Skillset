flowchart TB
subgraph laneP["Reporting Party/Report Provider"]
start((" "))
report["Send Price Report"]
cancel["Send Cancellation"]
correct{"Correction Required"}
end
subgraph laneU["Report User"]
received(["Price Report Received"])
endReport(((" ")))
cancelReceived(["Cancellation Received"])
endCancel(((" ")))
end
start --> report
report --> |"Statement"| received
received --> endReport
report -.-> |"Report incorrect or issued in error"| cancel
cancel --- |"Cancellation"| cancelReceived
cancelReceived --> endCancel
cancel --- correct
correct --- |"Yes"| report
style start fill:#222,stroke:#222,color:#222
