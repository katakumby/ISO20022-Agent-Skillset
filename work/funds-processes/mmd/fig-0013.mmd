flowchart TB
subgraph laneU["Requesting Party/Report User"]
start((" "))
request["Request Statement"]
status(["Status Received"])
endStatus(((" ")))
received(["Statement Received"])
endStatement(((" ")))
cancelReceived(["Cancellation Received"])
endCancel(((" ")))
end
subgraph laneP["Reporting Party/Report Provider"]
process["Process Request"]
accept{"Request Accepted?"}
statement["Send Statement"]
correct{"Correction Required?"}
cancel["Send Cancellation"]
end
start --> request
request --> |"Request"| process
process --- accept
accept --- |"Status / No"| status
status --> endStatus
accept --- |"Yes"| statement
statement --> |"Statement"| received
received --> endStatement
statement --- |"Yes"| correct
correct --- cancel
cancel --> |"Cancellation"| cancelReceived
cancelReceived --> endCancel
style start fill:#222,stroke:#222,color:#222
