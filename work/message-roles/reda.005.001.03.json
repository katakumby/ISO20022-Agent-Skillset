      "unclassified_narrative": [
        {
          "quote": "The Investment Fund Report Request message can be used to request one or many fund reference data report messages.",
          "raw_quote": "The Investment Fund Report Request message can be used to request one or many fund reference\ndata report messages.",
          "file_pages": [
            365
          ],
          "section": "scope"
        },
        {
          "quote": "If the InvestmentFundReportRequest message is used to request a fund reference data report then the request can specify the financial instrument for which the report is requested.",
          "raw_quote": "Usage\nIf the InvestmentFundReportRequest message is used to request a fund reference data report then the\nrequest can specify the financial instrument for which the report is requested.",
          "file_pages": [
            365
          ],
          "section": "usage"
        },
        {
          "quote": "Other appropriate parameters can also be included.",
          "raw_quote": "Other appropriate\nparameters can also be included.",
          "file_pages": [
            365
          ],
          "section": "usage"
        },
        {
          "quote": "It is also possible to indicate that the request is an open request, that is, there is no specific criteria for the report requested.",
          "raw_quote": "It is also possible to indicate that the request is an open request, that\nis, there is no specific criteria for the report requested.",
          "file_pages": [
            365
          ],
          "section": "usage"
        },
        {
          "quote": "For example, a request for a fund reference data report that is specified as \"no criteria\" means that the request is a request for a reference data report messages for all funds.",
          "raw_quote": "For example, a request for a fund reference data\nreport that is specified as \"no criteria\" means that the request is a request for a reference data report\nmessages for all funds.",
