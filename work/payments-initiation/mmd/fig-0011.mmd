flowchart TB
subgraph laneC["Creditor"]
returnC["Reconcile Return Direct Debit"]
endC((("Reconciled Returned Direct Debit")))
end
subgraph laneD["Debtor"]
end
subgraph laneCA["Creditor Agent"]
processCA["Process Cleared Return"]
debitCA["Reconcile Debit Entry"]
endCA((("Reconciled Debit Entry")))
end
subgraph laneCS["Clearing Agent"]
acceptClearing{"accept?"}
rejectClearing["Reject Direct Debit Return Instruction"]
clear["Clear Direct Debit Return"]
end
subgraph laneS["Settlement Agent"]
settle["Settle Direct Debit Return Proceeds"]
end
subgraph laneDA["Debtor Agent"]
return["Return Direct Debit"]
correctDA["Correct and Resubmit Rejected Return Instruction"]
creditDA["Reconcile Credit Entry"]
start(("Start"))
endDA((("Reconciled Credit Entry")))
end
return --> acceptClearing
acceptClearing --> |"no"| rejectClearing
rejectClearing --> correctDA
correctDA --> return
acceptClearing --> |"yes"| clear
clear --> processCA
processCA --> returnC
returnC --> endC
clear --> settle
settle --> debitCA
debitCA --> endCA
settle --> creditDA
start --> return
creditDA --> endDA
style start fill:#222,stroke:#222,color:#fff
