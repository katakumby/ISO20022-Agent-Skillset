%%{init: {"flowchart": {"htmlLabels": false, "wrappingWidth": 260}}}%%
flowchart TB
classDef green fill:#c5d0a5,stroke:#222,color:#000
classDef blue fill:#bfd4ee,stroke:#222,color:#000
classDef grey fill:#eeeeee,stroke:#555,color:#000
classDef bar fill:#222,stroke:#222,color:#222
subgraph A["InstructingParty"]
M("Monitor"):::green
R("Reconcile"):::blue
EA@{ shape: fr-circ, label: " " }
end
subgraph B["ServicingExecutingParty"]
S@{ shape: f-circ, label: " " }
T("SystemEvent Triggered"):::blue
D{"Report Required"}:::green
EN@{ shape: fr-circ, label: " " }
G("Generate Report"):::green
V{"Success"}:::green
ER("Error Processing"):::blue
EE@{ shape: fr-circ, label: " " }
RP("Report Pending Instructions"):::green
end
S --> T --> D
D -->|No| EN
D -->|Yes| G --> V
V -->|No| ER --> EE
V -->|Yes| RP --> M --> R --> EA
