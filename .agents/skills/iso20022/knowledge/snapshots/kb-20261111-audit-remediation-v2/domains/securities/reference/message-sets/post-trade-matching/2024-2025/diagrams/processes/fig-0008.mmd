flowchart TB
 subgraph Prior["Earlier lifecycle bands (gray in source)"]
 EP["Execution process"]
 AP["Allocation/Confirmation/Affirmation process"]
 end
 subgraph Trade["Trade Matching Process"]
 subgraph BLane["Broker / Underwriter"]
 direction TB
 BSend["Send Confirmation"]
 BIn["Incoming continuation<br/>(unlabelled source line)"]
 BCancel["Cancel Confirmation"]
 BRework{" "}
 BEndCircle((" "))
 BEndChoice{" "}
 BEnd(("To settlement<br/>process"))
 BCancelReceipt((" "))
 end
 subgraph CLane["Central Matching Utility"]
 direction TB
 CFB["Send Confirmation<br/>(Broker)"]
 CDis["Send Disaffirmation<br/>Status message"]
 CAff["Send Affirmation<br/>Status message"]
 CEndCircle((" "))
 CEndChoice{" "}
 CEnd(("To settlement<br/>process"))
 CancelEndpoint((" "))
 CStatus["Send Cancellation<br/>Status Advice"]
 end
 subgraph TLane["Institutional Investor / Issuer Agent"]
 direction TB
 Assess{" "}
 Dis["Send Disaffirmation"]
 Aff["Send Affirmation"]
 TEndCircle((" "))
 TEndChoice{" "}
 TEnd(("To settlement<br/>process"))
 TIn["Incoming continuation<br/>(unlabelled source line)"]
 OtherCancelReceipt((" "))
 end
 BIn -.-> BSend
 BSend --> CFB
 BRework -.-> BSend
 BRework -.-> BCancel
 Assess -.-> |"N.G."| Dis
 Assess -.-> |"O.K."| Aff
 Dis --> |"Disaffirmation message"| CDis
 CDis --> |"Disaffirmation Status message"| BRework
 Aff --> |"Affirmation message"| CAff
 BEndCircle -.-> BEndChoice
 BEndChoice -.-> BEnd
 CAff --> |"Affirmation Status message"| BEndCircle
 CAff -.-> CEndCircle
 CEndCircle -.-> CEndChoice
 CEndChoice -.-> CEnd
 Aff -.-> TEndCircle
 TEndCircle -.-> TEndChoice
 TEndChoice -.-> TEnd
 CFB --> Assess
 TIn -.-> Assess
 BCancel --> CancelEndpoint
 CStatus --> BCancelReceipt
 CStatus --> OtherCancelReceipt
 end
 style Prior fill:#ddd,stroke:#ddd
 style CLane fill:#b5b5b5,stroke:#777
 linkStyle default stroke:#777
 linkStyle 0,2,3,4,5,9,10,12,13,14,15,16,17,19 stroke:#3268d8
