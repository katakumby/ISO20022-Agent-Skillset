%%{init: {"flowchart": {"htmlLabels": false, "wrappingWidth": 260}}}%%
flowchart TB
classDef green fill:#c5d0a5,stroke:#222,color:#000
classDef blue fill:#bfd4ee,stroke:#222,color:#000
classDef grey fill:#eeeeee,stroke:#555,color:#000
classDef bar fill:#222,stroke:#222,color:#222
subgraph A["Instructing Party"]
Q("Send Settlement/IntraPosition Movement Cancellation/Modification Query"):::green
M("Monitor"):::green
R("Reconcile")
E@{ shape: fr-circ, label: " " }
end
subgraph B["Servicing Party"]
V("Validate Request"):::green
D{"Successful Process?"}:::green
ER("Error Processing")
SE("Send Error Response")
SR("Send Settlement/IntraPosition Movement Cancellation/ModificationResponse"):::green
end
Q --> V --> D
D -->|No| ER
ER -->|Yes| SE --> M
D -->|Yes| SR --> M
M --> R --> E
