    },
    {
      "row": 4,
      "column": 2,
      "source_cell": "Party that provides, through common membership, services to create a fair and open process for the execution of transactions between trading parties and the creation of settlement obligations.",
      "source_table_id": "T6",
      "word_pages": [
        11,
        12
      ],
      "resolution": "pass",
      "basis": "Directly read Word pages11–12: Market Infrastructure definition continues across the repeated table header."
    },
    {
      "row": 4,
      "column": 2,
      "source_cell": "The Instructing Party is known by the Executing/Servicing Party system and has been granted the appropriate privileges. An attribute of the security has changed which requires a modification of the security in the Executing/Servicing Party system.",
      "source_table_id": "T9",
      "word_pages": [
        13,
        14
      ],
      "resolution": "pass",
      "basis": "Directly read Word pages13–14: modification precondition continues after the table header with changed which requires a modification of the security."
    },
    {
      "row": 3,
      "column": 2,
      "source_cell": "Executing/Servicing Party checks if the instruction already exists in the system.\nIt checks also if the data can or cannot be updated.\nIf validation of the message fails, a status message “REJECTED” will be sent including the related errors and reason information.\nIf the message is valid and the time permits the update of the security (e.g. not during a night – time sequence), the data will be processed and a status message “COMPLETED” will be sent.\nOtherwise a status message “QUEUED” will be sent and the instruction will be resubmit to validation after e.g. a night –time cycle.",
      "source_table_id": "T15",
      "word_pages": [
        17,
        18
      ],
      "resolution": "pass",
      "basis": "Directly read Word pages17–18: Validate ends on page17 with instruction will be and continues on page18 with resubmit to validation after e.g. a night-time cycle."
    },
    {
      "row": 3,
      "column": 2,
      "source_cell": "Executing/Servicing Party checks if the instruction already exists in the system.\nIt checks also if the security can or cannot be deleted.\nIf validation of the message fails, a status message “REJECTED” will be sent including the related errors and reason information.\nIf the message is valid and the time permits the deletion of the security (e.g. not during a night – time sequence), the data will be processed and a status message “COMPLETED” will be sent.\nOtherwise a status message “QUEUED” will be sent and the instruction will be resubmit to validation after e.g. a night –time cycle.",
      "source_table_id": "T16",
      "word_pages": [
        18,
        19
      ],
      "resolution": "pass",
      "basis": "Directly read Word pages18–19: Validate begins on page18 and continues on page19 through checks, REJECTED/COMPLETED/QUEUED and resubmission conditions."
    }
  ],
