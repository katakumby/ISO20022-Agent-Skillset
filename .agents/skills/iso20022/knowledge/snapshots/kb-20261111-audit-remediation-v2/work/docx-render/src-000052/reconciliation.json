      "unmatched_cells": [
        {
          "row": 8,
          "column": 1,
          "source_cell": "Any penalty fees or other buy-in fees will be debited from the clearing member account (payment process – out of scope)."
        },
        {
          "row": 8,
          "column": 2,
          "source_cell": "Cancel settlement instruction: \nThe clearing member cancels the settlement instruction sent previously to the settlement agent/ CSD (settlement process – out of scope)."
        }
      ]
