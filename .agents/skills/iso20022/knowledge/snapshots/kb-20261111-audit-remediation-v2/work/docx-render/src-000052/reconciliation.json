      "matched_nonempty_cells": 14,
      "unmatched_cells": [
        {
          "row": 6,
          "column": 1,
          "source_cell": "Optional activity: \nWhen collateral is required, some CCPs may take cash automatically from the CM account (out of scope)."
        },
        {
          "row": 10,
          "column": 2,
          "source_cell": "If Yes, deliver the securities/cash/other:\nThe CM delivers the securities/cash accepted as new collateral (out of scope)."
        },
        {
          "row": 11,
          "column": 1,
          "source_cell": "If yes, receive the securities/cash/other:\nThe CCP receives the securities/cash accepted as new collateral (out of scope)."
        }
      ]
    },
    {
      "table_id": "tbl-0015",
      "source_table_id": "T15",
      "source_xml_path": "/w:document/w:body/w:tbl[15]",
      "heading_path": [
        "Description of BusinessActivities",
        "BusinessProcess - Risk Management – Default Fund Contribution Process"
      ],
      "physical_rows": 6,
      "nonempty_cells": 8,
      "result": "unmatched-cell-text-needs-inspection",
      "word_start_file_page": 20,
      "word_end_file_page": 22,
      "word_start_printed_page": 20,
      "matched_nonempty_cells": 7,
      "unmatched_cells": [
        {
          "row": 6,
          "column": 1,
          "source_cell": "If deficit: \nEither the CCP debits the CM account automatically or sends a payment instruction on behalf of the CM (if POA exists) - (out of scope).\nThe CCP may also send a Margin Call Request (optional, depends on each CCP’s rules)\nIf excess:\nThe CCP may return part of the contribution."
        }
      ]
    },
