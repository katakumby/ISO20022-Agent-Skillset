    {
      "source_table_id": "T15",
      "path": "domains/securities/reference/message-sets/t2s-securities-account-reference-data/december-2019/documents/src-000371/tables/tbl-0015.md",
      "physical_rows": 6,
      "nonempty_cells": 18,
      "automatic_matched_cells": 17,
      "visually_resolved_cells": [
        {
          "row": 3,
          "column": 2,
          "source_cell": "Executing/Servicing Party checks if the instruction already exists in the system.\nIt checks also if the data can or cannot be updated.\nIf validation of the message fails, a status message “REJECTED” will be sent including the related errors and reason information.\nIf the message is valid and the time permits the update of the securities account (e.g. not during a night –time sequence), the data will be processed and a status message “COMPLETED” will be sent.\nOtherwise a status message “QUEUED” will be sent and the instruction will be resubmit to validation after e.g. a night –time cycle."
        }
      ],
      "word_file_pages": [
        18,
        19
      ],
      "original_com_range": [
        18,
        19
      ],
      "transcription_review": "pass",
      "review_status": "reviewed"
    },
    {
      "source_table_id": "T16",
      "path": "domains/securities/reference/message-sets/t2s-securities-account-reference-data/december-2019/documents/src-000371/tables/tbl-0016.md",
      "physical_rows": 6,
      "nonempty_cells": 18,
      "automatic_matched_cells": 17,
      "visually_resolved_cells": [
        {
          "row": 3,
          "column": 2,
          "source_cell": "Executing/Servicing Party checks if the instruction already exists in the system.\nIt checks also if the securities account can or cannot be deleted.\nIf validation of the message fails, a status message “REJECTED” will be sent including the related errors and reason information.\nIf the message is valid and the time permits the deletion of the securities account (e.g. not during a night –time sequence), the data will be processed and a status message “COMPLETED” will be sent.\nOtherwise a status message “QUEUED” will be sent and the instruction will be resubmit to validation after e.g. a night –time cycle."
        }
      ],
