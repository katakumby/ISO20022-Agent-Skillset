      "matched_nonempty_cells": 17,
      "unmatched_cells": [
        {
          "row": 3,
          "column": 2,
          "source_cell": "Executing/Servicing Party checks if the instruction already exists in the system.\nIt checks also if the data can or cannot be updated.\nIn case of a Block/Unblock instruction, the Executing/Servicing Party checks also if the party can or cannot be blocked/unblocked \nIf validation of the message fails, a status message “REJECTED” will be sent including the related errors and reason information.\nIf the message is valid and the time permits the update of the party (e.g. not during a night –time sequence), the data will be processed and a status message “COMPLETED” will be sent.\nOtherwise a status message “QUEUED” will be sent and the instruction will be resubmit to validation after e.g. a night –time cycle."
        }
      ]
    },
