flowchart TB
  subgraph laneRE["Reporting Entity"]
    receiveRE(["Receive and Process Message"])
    endRE((("End")))
  end
  subgraph laneCA["Competent Authority"]
    receiveCA(["Receive Message"])
    delegateCA{"Delegation Agreement"}
    route(["Route Message"])
    process(["Process and Generate Message"])
    merge@{ shape: fork }
  end
  subgraph laneSA["Supervisory Authority"]
    start(("Start"))
    check(["Check Data Completeness"])
    create(["Create Message"])
    delegateSA{"Delegation Agreement"}
  end
  start --> check
  check --> create
  create --> delegateSA
  delegateSA -->|"Data Collection Agreement"| receiveRE
  delegateSA -->|"No Data Collection Agreement"| receiveCA
  receiveCA --> delegateCA
  delegateCA -->|"Calculation Agreement"| route
  delegateCA -->|"No Calculation Agreement"| process
  route --> merge
  process --> merge
  merge --> receiveRE
  receiveRE --> endRE
  classDef bar fill:#333,stroke:#333,color:#333;
  class merge bar;
