%%{init: {"flowchart": {"htmlLabels": false, "wrappingWidth": 260}}}%%
flowchart TB
classDef green fill:#c5d0a5,stroke:#222,color:#000
classDef blue fill:#bfd4ee,stroke:#222,color:#000
classDef grey fill:#eeeeee,stroke:#555,color:#000
classDef bar fill:#222,stroke:#222,color:#222
subgraph A["Instructing Party"]
S@{ shape: f-circ, label: " " }
Q("Query Intra-Position Movement Instructions"):::green
M("Monitor"):::green
R("Reconcile"):::blue
E@{ shape: fr-circ, label: " " }
end
subgraph B["Servicing/Executing Party"]
P("Process Query"):::green
D{"Processed?"}:::green
ER("Error Processing"):::green
SE("Send Error Response"):::green
SR("Send Intra Pos Movemenrt Instruction Response"):::green
J[" "]:::bar
end
S --> Q --> P --> D
D -->|No| ER --> SE --> J
D -->|Yes| SR --> J
J --> M --> R --> E
