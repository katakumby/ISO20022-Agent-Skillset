flowchart TB
  subgraph laneRE["Reporting Entity"]
    startRE(("Start"))
    capture(["Capture and submit Non-Working Days"])
    forkRE@{ shape: fork }
    delegateRE{"Delegation Agreement"}
    responseRE(["Receive and Process Response"])
    acceptedRE{"#160;"}
    correctRE(["Corrective Action (a)"])
    endRE((("End")))
  end
  subgraph laneCA["Competent Authority"]
    receiveCA(["Receive Message (a)"])
    delegateCA{"Delegation Agreement"}
    processCA(["Process Message"])
    submitCA(["Submit Message"])
    startCA(("Start"))
    datesCA(["Non-Working Day of the Year"])
    correctCA(["Corrective Action (b)"])
    forkCA@{ shape: fork }
    responseCA(["Receive Response"])
    responseDecision{"#160;"}
    processResponse(["Process Response"])
    acceptedCA{"#160;"}
    endCA((("End")))
    routeCA(["Route Response"])
    mergeCA@{ shape: fork }
    mergeResponse@{ shape: fork }
  end
  subgraph laneSA["Supervisory Authority"]
    mergeSA@{ shape: fork }
    receiveSA(["Receive Message (b)"])
    processSA(["Process Message and Generate Status Advice"])
    reportingType{"Reporting Type"}
    delegateSA{"Delegation Agreement"}
  end
  startRE --> capture
  capture --> forkRE
  forkRE --> delegateRE
  forkRE --> responseRE
  delegateRE -->|"Data Collection Agreement"| mergeSA
  delegateRE -->|"No Data Collection Agreement"| receiveCA
  receiveCA --> delegateCA
  delegateCA -->|"No Calculation Agreement"| processCA
  delegateCA -->|"Calculation Agreement"| submitCA
  processCA --> submitCA
  processCA --> mergeCA
  startCA --> datesCA
  datesCA --> submitCA
  submitCA --> forkCA
  forkCA --> mergeSA
  forkCA --> responseCA
  mergeSA --> receiveSA
  receiveSA --> processSA
  processSA --> reportingType
  reportingType -->|"Competent Authority"| mergeResponse
  reportingType -->|"Reporting Entity"| delegateSA
  delegateSA -->|"No Data Collection Agreement"| mergeResponse
  delegateSA -->|"Data Collection Agreement"| mergeCA
  mergeResponse --> responseCA
  responseCA --> responseDecision
  responseDecision -->|"No Calculation Agreement OR Competent Authority"| processResponse
  responseDecision -->|"Calculation Agreement"| routeCA
  processResponse --> acceptedCA
  acceptedCA -->|"Accepted"| endCA
  acceptedCA -->|"Rejected"| correctCA
  correctCA --> datesCA
  routeCA --> mergeCA
  mergeCA --> responseRE
  responseRE --> acceptedRE
  acceptedRE -->|"Accepted"| endRE
  acceptedRE -->|"Rejected"| correctRE
  correctRE --> capture
  classDef bar fill:#333,stroke:#333,color:#333;
  class forkRE,forkCA,mergeCA,mergeResponse,mergeSA bar;
